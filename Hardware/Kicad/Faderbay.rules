
(rules PCB Faderbay
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 280)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.6)
    )
    (layer_rule In1.Cu
      (active off)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.6)
    )
    (layer_rule In2.Cu
      (active off)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.6)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.4)
    )
  )
  (rule
    (width 150.0)
    (clearance 150.0)
    (clearance 75.0 (type smd_to_turn_gap))
    (clearance 150.0 (type smd))
    (clearance 150.0 (type "kicad_default"))
    (clearance 150.0 (type Power,Default))
    (clearance 150.0 (type Analog,Default))
    (clearance 150.0 (type USB,Default))
    (clearance 150.0 (type kicad))
  )
  (padstack "Via[0-3]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_800:400_um" "Via[0-3]_800:400_um" default
  )
  (via 
    "Via[0-3]_800:400_um-kicad_default" "Via[0-3]_800:400_um" "kicad_default"
  )
  (via 
    "Via[0-3]_800:400_um-Power,Default" "Via[0-3]_800:400_um" Power,Default
  )
  (via 
    "Via[0-3]_800:400_um-Analog,Default" "Via[0-3]_800:400_um" Analog,Default
  )
  (via 
    "Via[0-3]_800:400_um-USB,Default" "Via[0-3]_800:400_um" USB,Default
  )
  (via_rule
    default "Via[0-3]_800:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-3]_800:400_um-kicad_default"
  )
  (via_rule
    Power,Default "Via[0-3]_800:400_um-Power,Default"
  )
  (via_rule
    Analog,Default "Via[0-3]_800:400_um-Analog,Default"
  )
  (via_rule
    USB,Default "Via[0-3]_800:400_um-USB,Default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 150.0)
    )
    (layer_rule In1.Cu
      (rule 
        (width 0.0) 
      )
    )
    (layer_rule In2.Cu
      (rule 
        (width 0.0) 
      )
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(R49-Pad2)" "Net-(U10A--)" "Net-(U10B--)" "Net-(R50-Pad2)" "Net-(R51-Pad2)" "Net-(U10C--)" "Net-(U10D--)" "Net-(R52-Pad2)"
    SWDIO SWCLK SWO "unconnected-(J3-Pin_7-Pad7)" "unconnected-(J3-Pin_8-Pad8)" NRST "Net-(D2-A)" "Net-(J13-Pad3)"
    "Net-(Q1-B)" "UART_TX" "Net-(J20-Pad3)" "Net-(U7A--)" "Net-(R13-Pad2)" "Net-(U4-VCAP_1)" "Net-(U6-VOUT)" "Net-(J2-CC1)"
    "Net-(Q1-C)" "Net-(R19-Pad2)" "Net-(J10-Pad3)" "Net-(U4-VCAP_2)" "SPI_SCK" SCLK "SPI_MOSI" SID
    ~CS "DISP_CS" "unconnected-(U11-Pad11)" "unconnected-(U11-Pad12)" "Net-(U7C--)" "Net-(J2-CC2)" "unconnected-(U4-PC13-Pad2)" "unconnected-(U4-PC14-Pad3)"
    "unconnected-(U4-PC15-Pad4)" "HSE_IN" "HSE_OUT" "unconnected-(U4-PC0-Pad8)" "unconnected-(U4-PC1-Pad9)" "unconnected-(U4-PC2-Pad10)" "unconnected-(U4-PC3-Pad11)" "unconnected-(U4-PA1-Pad15)"
    "UART2_TX" "UART2_RX" "unconnected-(U4-PA4-Pad20)" "ENC_CH1" "ENC_CH2" "unconnected-(U4-PC4-Pad24)" "unconnected-(U4-PC5-Pad25)" "unconnected-(U4-PB0-Pad26)"
    "unconnected-(U4-PB1-Pad27)" "unconnected-(U4-PB2-Pad28)" "unconnected-(U4-PB10-Pad29)" "unconnected-(U4-PB11-Pad30)" BT1 BT2 BT3 BT4
    "MUX_S3" "MUX_S2" "MUX_S1" "MUX_S0" "unconnected-(U4-PA10-Pad43)" "unconnected-(U4-PA15-Pad50)" "unconnected-(U4-PC10-Pad51)" "unconnected-(U4-PC11-Pad52)"
    "unconnected-(U4-PD2-Pad54)" "unconnected-(U4-PB4-Pad56)" "unconnected-(U4-PB6-Pad58)" "unconnected-(U4-PB7-Pad59)" "Net-(U4-BOOT0)" "unconnected-(U4-PB8-Pad61)" "unconnected-(U4-PB9-Pad62)" "unconnected-(U3-NC-Pad4)"
    "Net-(C24-Pad1)" "Net-(J16-Pad3)" "Net-(U8A--)" "Net-(U8B--)" "Net-(R20-Pad2)" "Net-(R35-Pad2)" "Net-(U8C--)" "Net-(U8D--)"
    "Net-(R36-Pad2)" "Net-(U9C--)" "Net-(U9A--)" "Net-(DS1-LED+)" "Net-(U2-+)" "Net-(U9D--)" "Net-(R38-Pad2)" "Net-(U6-CAP+)"
    "Net-(U6-CAP-)" "Net-(R15-Pad2)" "Net-(J7-Pad3)" "Net-(J11-Pad3)" "Net-(J9-Pad3)" "Net-(U7B--)" "Net-(R14-Pad2)" "Net-(J6-Pad3)"
    "Net-(J18-Pad3)" "Net-(J5-Pad3)" "Net-(J9-Pad2)" "Net-(C4-Pad1)" "Net-(U9B--)" "Net-(J21-Pad3)" "Net-(U7D--)" "Net-(R16-Pad2)"
    "Net-(J15-Pad3)" "unconnected-(DS1-V0-Pad3)" "Net-(R33-Pad2)" "Net-(J19-Pad3)" "Net-(J17-Pad3)" "Net-(R37-Pad2)" "Net-(J8-Pad3)" "Net-(D1-A)"
    "Net-(R34-Pad2)" "Net-(J22-Pad3)" "Net-(J12-Pad3)" "unconnected-(U6-NC-Pad1)" "unconnected-(U6-LV-Pad6)" "unconnected-(SW3-DUMMY1-PadD1)" "unconnected-(SW3-DUMMY2-PadD2)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 150.0)
    )
    (layer_rule In1.Cu
      (rule 
        (width 0.0) 
      )
    )
    (layer_rule In2.Cu
      (rule 
        (width 0.0) 
      )
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power,Default
    GNDA +5VA GNDD +3.3V "Net-(SW6-A)" +5VD GND "Net-(F1-Pad1)"
    (clearance_class Power,Default)
    (via_rule Power,Default)
    (rule
      (width 500.0)
    )
    (layer_rule In1.Cu
      (rule 
        (width 0.0) 
      )
    )
    (layer_rule In2.Cu
      (rule 
        (width 0.0) 
      )
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Analog,Default
    P12 P13 P14 "-5VA" P15 P3 "ADC_BUFF" P2
    VDDA "ADC_IN" P7 P6 P5 P4 P1 P0
    P11 P10 P9 P8
    (clearance_class Analog,Default)
    (via_rule Analog,Default)
    (rule
      (width 200.0)
    )
    (layer_rule In1.Cu
      (rule 
        (width 0.0) 
      )
    )
    (layer_rule In2.Cu
      (rule 
        (width 0.0) 
      )
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class USB,Default
    "USB_CONN_D+" "USB_CONN_D-" "USB_VBUS" "USB_D-" "USB_D+"
    (clearance_class USB,Default)
    (via_rule USB,Default)
    (rule
      (width 150.0)
    )
    (layer_rule In1.Cu
      (rule 
        (width 0.0) 
      )
    )
    (layer_rule In2.Cu
      (rule 
        (width 0.0) 
      )
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)